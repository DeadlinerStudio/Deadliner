<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_collection_row"
    android:layout_width="match_parent"
    android:layout_height="31dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/widget_task_collection_row_background"
        android:layout_width="match_parent"
        android:layout_height="27dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="27dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/widget_task_collection_row_indicator"
            android:layout_width="3dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_task_collection_indicator" />

        <TextView
            android:id="@+id/widget_task_collection_row_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_task_collection_row_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="10sp" />

    </LinearLayout>

</FrameLayout>
